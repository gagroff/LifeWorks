<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavGroup Title="Property Management" Icon="@Icons.Material.Filled.HomeWork" Expanded="true">
        <MudNavLink Href="improvements" Icon="@Icons.Material.Filled.Build">
            Home Improvements
        </MudNavLink>
        <MudNavLink Href="assets" Icon="@Icons.Material.Filled.Inventory2">
            Assets
        </MudNavLink>
        <MudNavLink Href="contractors" Icon="@Icons.Material.Filled.Engineering">
            Contractors
        </MudNavLink>
        <MudNavLink Href="maintenance" Icon="@Icons.Material.Filled.EventRepeat">
            Maintenance
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="settings/properties" Icon="@Icons.Material.Filled.House">
            Properties
        </MudNavLink>
        <MudNavLink Href="settings/categories" Icon="@Icons.Material.Filled.Category">
            Categories
        </MudNavLink>
    </MudNavGroup>

    <AuthorizeView>
        <Authorized>
            <form action="/logout" method="post" style="margin:0">
                <AntiforgeryToken />
                <MudNavGroup Title="@context.User.Identity?.Name" Icon="@Icons.Material.Filled.Person" Expanded="false">
                    <MudNavLink Icon="@Icons.Material.Filled.Logout">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Default"
                                   Style="text-align:left;padding:0;min-width:0">Sign out</MudButton>
                    </MudNavLink>
                </MudNavGroup>
            </form>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
